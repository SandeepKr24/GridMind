# Secrets
# .env.* also covers .env.local, which the Neon CLI rewrites on every deploy.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python build and test artefacts
# egg-info is regenerated by `uv pip install -e`; .coverage is a local database.
*.egg-info/
build/
dist/
.coverage
.coverage.*
coverage.xml
htmlcov/

# FastF1 cache
fastf1-cache/
.fastf1-cache/
cache/

# Node / Next.js
node_modules/
.next/
out/
.vercel/

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Neon CLI local state (project link, pulled env vars)
.neon

# Vendored agent skills. These are third-party docs fetched from
# neondatabase/agent-skills; skills-lock.json pins the versions and hashes, so
# `neon skills -y` restores them. Project-level .claude config is not ignored.
.claude/skills/

# Local-only documents, deliberately never pushed
F1_Race_Analyst_*.md
JOURNAL.md

# Brand source artwork. The files the site serves are copied into frontend/app
# and frontend/public, since Vercel only sees what is committed.
Logo/
