# GridMind backend configuration.
#
# Copy to backend/.env and fill in. backend/.env is gitignored; this file is not,
# so never put a real credential here.
#
# The Neon CLI also writes DATABASE_URL and DATABASE_URL_UNPOOLED into the
# repo-root .env.local when `neon deploy` runs, and overwrites that file each
# time. Treat .env.local as Neon's, and keep GridMind's own settings here.

# --- Database -----------------------------------------------------------
# Use Neon's DIRECT endpoint, not the "-pooler" host: the pooler runs in
# transaction mode and does not support prepared statements. In .env.local
# that is DATABASE_URL_UNPOOLED.
DATABASE_URL=

# The role the SQL agent runs as. SELECT grants only, enforced by the
# database. Same host and database as DATABASE_URL, different user.
# Create it with CREATE ROLE in SQL, never in the Neon console's Roles tab:
# a console-created role is a member of neon_superuser and could write
# regardless of what we grant it.
DATABASE_URL_READONLY=

# Our tables live here rather than in public.
DATABASE_SCHEMA=gridmind

# --- LLM ----------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=

# --- Ingestion ----------------------------------------------------------
# FastF1's cache must persist across restarts or every session re-downloads.
FASTF1_CACHE_DIR=.fastf1-cache
MAX_CONCURRENT_INGESTION_JOBS=2
INGESTION_JOB_TIMEOUT_SECONDS=300
MAX_SESSIONS_PER_QUESTION=2

# --- Standings ----------------------------------------------------------
# Ergast is retired; jolpica-f1 is the free successor.
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
STANDINGS_CACHE_TTL_HOURS=24

# --- Conversations ------------------------------------------------------
# Conversations live in memory only and are forgotten on restart.
CONVERSATION_TTL_MINUTES=60
MAX_CONVERSATIONS_IN_MEMORY=500

# --- Reports ------------------------------------------------------------
AUTO_REPORT_ENABLED=true
AUTO_REPORT_CHECK_CRON=

# --- API ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_INGEST_PER_HOUR=20
