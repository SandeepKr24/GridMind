# Base URL of the GridMind FastAPI backend.
# The backend runs as a container (Railway/Render/Fly), not on Vercel.
# Use 127.0.0.1, not localhost: the dev server binds IPv4 only, while
# Chromium resolves localhost to ::1 first and the request never lands.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
